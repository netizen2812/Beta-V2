FROM python:3.10-slim

WORKDIR /usr/src/app

# Install system dependencies needed for compilation and audio processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    libsndfile1 \
    espeak-ng \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy python requirements and install them
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt --extra-index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir --no-deps openvoice-cli==0.0.5


# Environment variables for caching
ENV HF_HOME=/root/.cache/huggingface
ENV COQUI_TOS_AGREED=1

# Pre-download the heavy HuggingFace models during the image build phase
# This ensures 0-second cold start times upon preemptive VM restarts
RUN python -c '\
from transformers import AutoProcessor, AutoModelForSpeechSeq2Seq, Wav2Vec2Processor, Wav2Vec2ForCTC;\
AutoProcessor.from_pretrained("tarteel-ai/whisper-base-ar-quran");\
AutoModelForSpeechSeq2Seq.from_pretrained("tarteel-ai/whisper-base-ar-quran");\
Wav2Vec2Processor.from_pretrained("TBOGamer22/wav2vec2-quran-phonetics");\
Wav2Vec2ForCTC.from_pretrained("TBOGamer22/wav2vec2-quran-phonetics")\
'

# Copy source code and config files
COPY . .

EXPOSE 8000

# Entrypoint: start server directly since heavy models are already baked in
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

